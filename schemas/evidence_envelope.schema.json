{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceEnvelope",
  "description": "Structured envelope separating deterministic Canonical Evidence from non-deterministic Runtime Receipts",
  "type": "object",
  "required": [
    "canonical_evidence",
    "runtime_receipt"
  ],
  "properties": {
    "canonical_evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "phase",
        "input_hash",
        "output_hash",
        "method_version",
        "schema_version",
        "execution_context_hash",
        "artifact_payload"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^evi-[a-f0-9]{8,16}$"
        },
        "phase": {
          "type": "string",
          "enum": ["question", "delete", "simplify", "verify", "codify"]
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of target source code and parameters"
        },
        "output_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of artifact payload"
        },
        "method_version": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "execution_context_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "runtime_receipt": {
      "type": "object",
      "required": [
        "producer",
        "timestamp",
        "duration_ms",
        "checks",
        "status"
      ],
      "properties": {
        "producer": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "number"
        },
        "checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "BLOCKED", "WARN"]
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
